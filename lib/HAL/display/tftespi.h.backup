#ifndef HAL_TFTESPI_H
#define HAL_TFTESPI_H

#include <TFT_eSPI.h>
#include "tft.h"

class tft_display : private TFT_eSPI {
public:
    void init();
    void setRotation(uint8_t rotation);
    uint8_t getRotation();
    
    void fillScreen(uint32_t color);
    void fillRect(int32_t x, int32_t y, int32_t w, int32_t h, uint32_t color);
    void fillCircle(int32_t x, int32_t y, int32_t r, uint32_t color);
    void fillEllipse(int16_t x, int16_t y, int32_t rx, int32_t ry, uint16_t color);
    
    void drawFastHLine(int32_t x, int32_t y, int32_t w, uint32_t color);
    void drawFastVLine(int32_t x, int32_t y, int32_t h, uint32_t color);
    
    void setTextFont(uint8_t font);
    void setTextColor(uint16_t color, uint16_t bgcolor = TFT_BLACK);
    void setTextSize(uint8_t size);
    void setTextWrap(bool wrap);
    void setCursor(int16_t x, int16_t y);
    void print(const char *text);
    
    int16_t textWidth(const char *text);
    int16_t fontHeight();
    
    void pushImage(int32_t x, int32_t y, int32_t w, int32_t h, const uint8_t *data);
    
    void startWrite();
    void endWrite();
    
    TFT_eSPI *native();
};

class tft_sprite : private TFT_eSprite {
public:
    tft_sprite(tft_display *parent);
    
    void *createSprite(int16_t w, int16_t h, uint8_t frames = 1);
    void deleteSprite();
    void setColorDepth(uint8_t depth);
    void fillScreen(uint32_t color);
    void fillRect(int32_t x, int32_t y, int32_t w, int32_t h, uint32_t color);
    void fillCircle(int32_t x, int32_t y, int32_t r, uint32_t color);
    void fillEllipse(int16_t x, int16_t y, int32_t rx, int32_t ry, uint16_t color);
    
    void drawFastHLine(int32_t x, int32_t y, int32_t w, uint32_t color);
    void drawFastVLine(int32_t x, int32_t y, int32_t h, uint32_t color);
    
    void pushSprite(int32_t x, int32_t y, uint32_t transparent = 0x00FFFFFF);
    void pushToSprite(tft_sprite *dest, int32_t x, int32_t y, uint32_t transparent = 0x00FFFFFF);
    
    void setTextFont(uint8_t font);
    void setTextColor(uint16_t color, uint16_t bgcolor = TFT_BLACK);
    void setTextSize(uint8_t size);
    void setTextWrap(bool wrap);
    void setCursor(int16_t x, int16_t y);
    void print(const char *text);
    
    int16_t textWidth(const char *text);
    int16_t fontHeight();
    
    TFT_eSprite *nativeSprite();
};

#endif // HAL_TFTESPI_H